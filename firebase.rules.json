{
  "rules": {
    "tournament": {
      ".read": true,
      ".write": "root.auth.uid !== null && root.auth.token.admin === true",
      "groups": {
        ".validate": "newData.hasChildren(['A', 'B', 'C', 'D'])"
      },
      "groupMatches": {
        ".validate": "newData.hasChildren(['A', 'B', 'C', 'D'])"
      },
      "knockout": {
        ".validate": "newData.hasChildren(['quarterfinals', 'semifinals', 'final', 'thirdPlace'])"
      },
      "lastUpdated": {
        ".validate": "newData.isString()"
      }
    }
  }
}
